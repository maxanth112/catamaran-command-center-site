{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "boat.schema.json",
  "title": "Boat",
  "type": "object",
  "required": ["id", "tier", "score", "name", "model", "location", "ask_display", "why", "risks", "stage", "stage_bucket", "next_step", "listed_date", "listed_date_precision", "listed_date_confidence", "listed_date_source", "listed_date_notes", "market_end_date"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "tier": {"type": "string", "enum": ["A", "B", "C", "D"]},
    "score": {"type": "number", "minimum": 0, "maximum": 10},
    "name": {"type": "string"},
    "year": {"type": ["integer", "null"]},
    "model": {"type": "string"},
    "location": {"type": "string"},
    "ask_display": {"type": "string"},
    "ask_currency": {"type": ["string", "null"]},
    "ask_value": {"type": ["number", "null"]},
    "why": {"type": "string"},
    "risks": {"type": "string"},
    "refit_display": {"type": "string"},
    "refit_low": {"type": ["number", "null"]},
    "refit_high": {"type": ["number", "null"]},
    "all_in_display": {"type": "string"},
    "all_in_low": {"type": ["number", "null"]},
    "all_in_high": {"type": ["number", "null"]},
    "stage": {"type": "string"},
    "stage_bucket": {"type": "string", "enum": ["diligence", "waiting", "max_decision", "watch", "closed", "other"]},
    "contact": {"type": "string"},
    "contact_channel": {"type": "string"},
    "last_activity": {"type": "string"},
    "next_step": {"type": "string"},
    "listing_url": {"type": "string"},
    "listed_date": {"type": ["string", "null"], "format": "date"},
    "listed_date_precision": {"enum": ["day", "month", null]},
    "listed_date_confidence": {"type": "string", "enum": ["verified", "first_seen", "estimated", "unknown"]},
    "listed_date_source": {"type": ["string", "null"]},
    "listed_date_notes": {"type": "string"},
    "market_end_date": {"type": ["string", "null"], "format": "date"},
    "notes": {"type": "string"},
    "latest_email_thread": {"type": "string"},
    "last_heard_from": {"type": "string"},
    "last_reached_out": {"type": "string"}
  },
  "additionalProperties": false
}
